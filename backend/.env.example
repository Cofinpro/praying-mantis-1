# Matches the mysql service in ../docker-compose.yml
DB_USER=app
DB_PASSWORD=app
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=praying_mantis
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,https://cofinpro.github.io
# Signs login tokens (JWT). At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-at-least-32-characters
